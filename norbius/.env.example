# ─────────────────────────────────────────────────────────────
# NORBIUS — variáveis de ambiente (desenvolvimento local)
# Copie para .env e ajuste. Nunca versione o .env.
# ─────────────────────────────────────────────────────────────

# Ambiente: development | test | staging | production
APP_ENV=development

# Origem pública do app web (o navegador fala só com ela)
APP_URL=http://localhost:3000
# Endereço interno da API, usado pelo proxy do Next (server-side)
API_URL=http://localhost:4000
PORT=4000

# Banco — a aplicação usa o papel restrito norbius_app (sujeito a RLS)
DATABASE_URL=postgres://norbius_app:norbius_app@localhost:5432/norbius
# Migrações usam o papel dono do schema
DATABASE_MIGRATION_URL=postgres://norbius_owner:norbius_owner@localhost:5432/norbius

# Redis (obrigatório em staging/produção para rate limit distribuído)
REDIS_URL=redis://localhost:6379

# Autenticação — gere com: openssl rand -base64 48
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Login com Google (opcional; o botão só aparece se ambos estiverem definidos)
# Redirect URI autorizado no Google: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (obrigatório em staging/produção; em dev, sem chave, os e-mails vão para o log da API)
RESEND_API_KEY=
EMAIL_FROM="NORBIUS <nao-responda@norbius.com.br>"

# Segurança
AUTH_RATE_LIMIT_ENABLED=true
# HIBP_ENABLED=true       # padrão: ligado em staging/produção
TRUST_PROXY_HOPS=1         # nº de proxies confiáveis à frente da API
# Compartilhado entre API e web (SSR). Obrigatório em staging/produção: openssl rand -base64 48
INTERNAL_API_SECRET=
LOG_LEVEL=info

# NORBIUS AI (opcional; sem chave o assistente fica desativado)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MONTHLY_MESSAGE_LIMIT=100

# Assinaturas — Asaas (opcional; sem chave, só o teste grátis funciona)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Mesmo token configurado no webhook do painel do Asaas: openssl rand -base64 48
ASAAS_WEBHOOK_TOKEN=

# Voz neural local (Piper, ver tts/server.py fora do repositório). Sem ela, o assistente usa a voz do navegador.
TTS_URL=

# Análise diária (06:00 no fuso do usuário) e envio dos e-mails de aviso. Com várias instâncias da API, deixe true em só uma.
JOBS_ENABLED=true

# Painel admin (Fase 7, ADR 0007). Sem DATABASE_ADMIN_URL o módulo admin não existe.
# Papel restrito criado por infra/db/setup-local.sh (sem acesso a dados financeiros).
DATABASE_ADMIN_URL=postgres://norbius_admin:norbius_admin@localhost:5432/norbius
ADMIN_URL=http://localhost:3001
# openssl rand -base64 32 — cifra os segredos do autenticador dos admins
ADMIN_ENCRYPTION_KEY=
