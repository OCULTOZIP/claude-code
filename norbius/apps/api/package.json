{
  "name": "@norbius/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../../node_modules/**\" --exclude \"**/node_modules/**\" --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:ai": "tsx --env-file-if-exists=../../.env evals/run.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@norbius/contracts": "workspace:*",
    "@norbius/db": "workspace:*",
    "@norbius/domain": "workspace:*",
    "@norbius/intelligence": "workspace:*",
    "@norbius/observability": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.6.0",
    "pdfkit": "^0.17.2",
    "qrcode-terminal": "^0.12.0",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
