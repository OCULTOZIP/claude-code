{
  "name": "norbius",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @norbius/db generate",
    "db:migrate": "pnpm --filter @norbius/db migrate",
    "db:setup": "bash infra/db/setup-local.sh",
    "test:e2e": "pnpm --filter @norbius/web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  }
}
